# Copy to .env. Every value is optional; the offline demo needs none of them.

# Database (SQLite by default; any SQLAlchemy URL works)
# AGENTSHIELD_DATABASE_URL=sqlite:///./.agentshield/agentshield.db

# API server (keep 127.0.0.1 unless you understand the exposure)
# AGENTSHIELD_HOST=127.0.0.1
# AGENTSHIELD_PORT=8000
# AGENTSHIELD_CORS_ORIGINS=["http://localhost:5173"]
# Require `Authorization: Bearer <token>` on mutating endpoints:
# AGENTSHIELD_API_TOKEN=

# Live model red-teaming (incurs API charges). The key is read by the Anthropic SDK; never stored.
# ANTHROPIC_API_KEY=
# AGENTSHIELD_ANTHROPIC_MODEL=claude-opus-5-5
# AGENTSHIELD_ANTHROPIC_EFFORT=medium
# AGENTSHIELD_ANTHROPIC_REFUSAL_FALLBACK=true

# AWS read-only scanning: use the standard credential chain (profile, SSO, role). Do not put keys here.
# AGENTSHIELD_AWS_PROFILE=security-audit
# AGENTSHIELD_AWS_REGIONS=["us-east-1"]
